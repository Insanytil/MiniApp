# Browser API URL. In development, Vite proxies /api to http://127.0.0.1:8000.
# In production, configure your reverse proxy to expose /api on the same origin.
VITE_API_BASE_URL=/api

# Must match the backend's cookie/header names. Never put secrets in VITE_*.
VITE_CSRF_COOKIE_NAME=miniapp_csrf
VITE_CSRF_HEADER_NAME=X-CSRF-Token
