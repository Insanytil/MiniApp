# Configuration locale : copier ce fichier vers backend/.env.
# Lancer l'API et le worker depuis backend/ (lecture de .env depuis le dossier courant).
# Depuis la racine du projet, démarrer les services avec :
# docker compose --env-file backend/.env -f infra/compose.yaml up -d

# Application
APP_NAME="MiniApp API"
ENVIRONMENT=development
FRONTEND_BASE_URL=http://localhost:3000

# PostgreSQL : identifiants partagés par le backend et Docker Compose.
# Exemple de mot de passe local uniquement ; à remplacer dans votre .env.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=miniapp
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=miniapp

# Authentification
AUTH_SESSION_LIFETIME_HOURS=24
AUTH_SESSION_COOKIE_NAME=miniapp_session
AUTH_CSRF_COOKIE_NAME=miniapp_csrf
AUTH_CSRF_HEADER_NAME=X-CSRF-Token
# Utiliser true en production avec HTTPS.
AUTH_COOKIE_SECURE=false
INVITATION_LIFETIME_HOURS=48
PASSWORD_RESET_LIFETIME_MINUTES=60

# SMTP local via Mailpit ; interface de consultation : http://localhost:8025
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SENDER_EMAIL=no-reply@miniapp.local
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

# Celery / Redis
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
REDIS_PORT=6379

# Si les ports Docker changent, adapter aussi les paramètres du backend :
# MAILPIT_SMTP_PORT -> SMTP_PORT ; REDIS_PORT -> les deux URL Celery.
